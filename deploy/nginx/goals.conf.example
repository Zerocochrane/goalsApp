# Nginx como proxy reverso do Goals App, com HTTPS (Let's Encrypt).
#
# O HTTPS é necessário: o link enviado pelo WhatsApp usa APP_URL (https://…) e o cookie de
# login é "secure" quando APP_URL começa com https://.
#
# Instalação (Ubuntu), trocando metas.example.com pelo seu domínio:
#   sudo cp deploy/nginx/goals.conf.example /etc/nginx/sites-available/goals.conf
#   sudo sed -i 's/metas.example.com/SEU.DOMINIO/g' /etc/nginx/sites-available/goals.conf
#   sudo ln -s /etc/nginx/sites-available/goals.conf /etc/nginx/sites-enabled/
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d SEU.DOMINIO     # emite o certificado e renova sozinho (timer)
#   sudo nginx -t && sudo systemctl reload nginx
#
# Antes do certbot, deixe só o bloco "listen 80" (sem as linhas ssl_*) ou rode
# `sudo certbot certonly --nginx -d SEU.DOMINIO` primeiro. Libere as portas 80 e 443
# no firewall (no Oracle Cloud: Security List da VCN + iptables do Ubuntu).
# A porta 4101 NÃO precisa ficar aberta para a internet — só o Nginx fala com ela.
#
# Depois, em server/.env:  APP_URL=https://SEU.DOMINIO   e rode `npm run deploy`.

upstream goals_app {
    server 127.0.0.1:4101;   # WEB_PORT de server/.env (processo goals-app no PM2)
    keepalive 16;
}

# HTTP → HTTPS (mantendo o desafio do Let's Encrypt acessível)
server {
    listen 80;
    listen [::]:80;
    server_name metas.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name metas.example.com;

    ssl_certificate     /etc/letsencrypt/live/metas.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/metas.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Anexos das atividades: até 5 MB (+ folga do multipart). O app também recusa > 5 MB.
    client_max_body_size 6m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://goals_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # IP real do cliente (o app confia em proxies em 127.0.0.1 — rate limit do login)
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }
}
