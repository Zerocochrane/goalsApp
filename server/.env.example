# Portas — diferentes do Site (que usa 4000) para não haver conflito.
# Produção (PM2): um único processo serve a API e o frontend em WEB_PORT (o Nginx aponta
# para ela). Desenvolvimento: a API fica em API_PORT e o Vite em WEB_PORT.
API_PORT=4100
WEB_PORT=4101

# Porta do servidor Node (opcional). Se vazia, usa API_PORT. O PM2 já define PORT=WEB_PORT.
PORT=

# Endereço público do app (usado no link enviado pelo WhatsApp).
# Em produção, o domínio com HTTPS (ex.: https://metas.seudominio.com.br)
APP_URL=http://localhost:4101

# Banco SQLite (fica em server/data/, que o deploy nunca apaga)
DATABASE_URL="file:./data/goals.db"

# Qualquer texto longo e aleatório, usado para assinar o login — TROQUE
JWT_SECRET=replace-with-a-long-random-string

# Cookie de login só via HTTPS. Vazio = automático: segue o APP_URL
# (https:// → só HTTPS; http:// → funciona sem HTTPS). true/false força o valor.
COOKIE_SECURE=

# Admin master criado no primeiro start — TROQUE a senha
MASTER_ADMIN_USER=admin
MASTER_ADMIN_PASSWORD=change-me

# Cadastro pela própria pessoa (link "Criar conta" no login):
#   aprovacao = a conta aguarda o master aprovar na página Usuários (padrão)
#   aberto    = a conta é liberada logo após confirmar o telefone pelo WhatsApp
#   desligado = sem cadastro; só o master cria usuários
SIGNUP_MODE=aprovacao

# WhatsApp (Baileys — biblioteca não oficial: use um número dedicado)
# Pasta da sessão, relativa a server/ (fora do git). Após parear, reinícios não pedem QR.
WA_SESSION_DIR=data/wa-session
# Intervalo mínimo entre envios, em milissegundos
WA_SEND_INTERVAL_MS=3000
# true desliga a conexão (ex.: em desenvolvimento, para não disputar a sessão com produção)
WA_DISABLED=

# Backup diário do SQLite (03:00) — pasta relativa a server/ e dias guardados
BACKUP_DIR=data/backups
BACKUP_KEEP_DAYS=14

# Anexos das atividades (fotos/PDF, até 5 MB) — pasta relativa a server/
UPLOAD_DIR=data/uploads

TZ=America/Sao_Paulo
