// Modelos do Goals App — SQLite via better-sqlite3 (driver adapter do Prisma).
// Datas "de calendário" (AAAA-MM-DD) ficam como texto no fuso America/Sao_Paulo;
// instantes (createdAt, scheduledAt…) ficam como DateTime (UTC).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  pendente
  concluida
  falhou
}

model User {
  id                   Int      @id @default(autoincrement())
  username             String   @unique
  passwordHash         String
  name                 String
  phone                String? // WhatsApp em formato E.164 (ex.: +5532999999999)
  isMaster             Boolean  @default(false)
  lastCelebratedStreak Int      @default(0)
  createdAt            DateTime @default(now())

  activities  Activity[]
  occurrences TaskOccurrence[]
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  hour      Int // 0–23
  minute    Int // 0–59
  weekdays  Json // lista de dias 0–6 (0 = domingo, 1 = segunda … 6 = sábado), ex.: [1,3,5]
  startDate String // AAAA-MM-DD (data clicada no calendário)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences TaskOccurrence[]

  @@index([userId])
}

// Execução de uma atividade em um dia
model TaskOccurrence {
  id          Int        @id @default(autoincrement())
  activityId  Int
  userId      Int
  date        String // AAAA-MM-DD
  scheduledAt DateTime
  status      TaskStatus @default(pendente)
  token       String     @unique // aleatório, usado no link enviado pelo WhatsApp
  expiresAt   DateTime // scheduledAt + 1h
  notifiedAt  DateTime?
  completedAt DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, date])
  @@index([userId, date])
  @@index([status, scheduledAt])
}
