// Modelos do Goals App — SQLite via better-sqlite3 (driver adapter do Prisma).
// Datas "de calendário" (AAAA-MM-DD) ficam como texto no fuso America/Sao_Paulo;
// instantes (createdAt, scheduledAt…) ficam como DateTime (UTC).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  pendente
  concluida
  falhou
}

model User {
  id                   Int      @id @default(autoincrement())
  username             String   @unique
  passwordHash         String
  name                 String
  phone                String? // WhatsApp em formato E.164 (ex.: +5532999999999)
  isMaster             Boolean  @default(false)
  lastCelebratedStreak Int      @default(0)
  sessionVersion       Int      @default(0) // muda ao trocar a senha: derruba sessões antigas
  createdAt            DateTime @default(now())

  activities       Activity[]
  occurrences      TaskOccurrence[]
  friendsRequested Friendship[]     @relation("FriendshipRequester")
  friendsReceived  Friendship[]     @relation("FriendshipAddressee")
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  hour      Int // 0–23
  minute    Int // 0–59
  weekdays  Json // lista de dias 0–6 (0 = domingo, 1 = segunda … 6 = sábado), ex.: [1,3,5]
  startDate String // AAAA-MM-DD (data clicada no calendário)
  endDate   String? // AAAA-MM-DD, último dia em que a atividade vale (null = sem fim)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences TaskOccurrence[]

  @@index([userId])
}

// Execução de uma atividade em um dia
model TaskOccurrence {
  id          Int        @id @default(autoincrement())
  activityId  Int
  userId      Int
  date        String // AAAA-MM-DD
  scheduledAt DateTime
  status      TaskStatus @default(pendente)
  token       String     @unique // aleatório, usado no link enviado pelo WhatsApp
  expiresAt   DateTime // scheduledAt + 1h
  notifiedAt  DateTime?
  completedAt DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, date])
  @@index([userId, date])
  @@index([status, scheduledAt])
}

enum MessageStatus {
  enviada
  falhou
}

// Log de envios do WhatsApp (sucesso ou falha)
model MessageLog {
  id        Int           @id @default(autoincrement())
  phone     String // E.164 (+5532999999999)
  text      String
  status    MessageStatus
  error     String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
}

enum FriendshipStatus {
  pendente
  aceita
}

// Amizade entre dois usuários: nasce como pedido (pendente) e vira amizade ao ser aceita.
// Recusar, cancelar ou desfazer apaga a linha (permite um novo pedido depois).
model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int // quem enviou o pedido
  addresseeId Int // quem recebeu
  // Par de usuários independente da ordem ("menorId:maiorId"): impede pedidos duplicados
  // nos dois sentidos (A→B e B→A)
  pairKey     String           @unique
  status      FriendshipStatus @default(pendente)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([addresseeId, status])
}
